---
import ArcadeLayout from '../../layouts/ArcadeLayout.astro';
---
<ArcadeLayout title="Pong · MAY'D IT ARCADE">
  <section class="arcade-shell game-page">
    <a class="back" href="/">← SELECT GAME</a>
    <div class="game-heading"><div><p class="prompt">PROGRAM 02</p><h1>PONG</h1></div><div class="scoreboard"><span id="left-score">00</span> : <span id="right-score">00</span></div></div>
    <canvas id="pong" width="800" height="480" aria-label="Pong game"></canvas>
    <p class="subtle">LEFT: W/S · RIGHT: ↑/↓ · SPACE TO SERVE</p>
  </section>
  <script src="../../scripts/pong.ts"></script>
</ArcadeLayout>
