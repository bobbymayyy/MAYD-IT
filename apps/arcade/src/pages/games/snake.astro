---
import ArcadeLayout from '../../layouts/ArcadeLayout.astro';
---
<ArcadeLayout title="Snake · MAY'D IT ARCADE">
  <section class="arcade-shell game-page">
    <a class="back" href="/">← SELECT GAME</a>
    <div class="game-heading"><div><p class="prompt">PROGRAM 01</p><h1>SNAKE</h1></div><div class="scoreboard">SCORE <span id="score">0000</span></div></div>
    <canvas id="snake" width="720" height="480" aria-label="Snake game"></canvas>
    <p class="subtle">KEYBOARD: ARROWS / WASD · TOUCH: SWIPE ON GRID · SPACE OR TAP AFTER FAILURE TO RESTART</p>
  </section>
  <script src="../../scripts/snake.ts"></script>
</ArcadeLayout>
