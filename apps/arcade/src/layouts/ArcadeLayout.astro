---
import '../styles/arcade.css';
import '../styles/interaction.css';
const { title = "MAY'D IT ARCADE" } = Astro.props;
const description = 'A tiny client-side arcade from MAY\'D IT. No account, backend, or persistent player state.';
const canonical = new URL(Astro.url.pathname, 'https://play.mayyy.us');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#020702" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MAY'D IT ARCADE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
  </head>
  <body>
    <header class="arcade-header">
      <a href="/">MAY'D IT // ARCADE</a>
      <nav><a href="https://mayyy.us">EXIT TO MAYYY.US</a></nav>
    </header>
    <main><slot /></main>
  </body>
</html>
