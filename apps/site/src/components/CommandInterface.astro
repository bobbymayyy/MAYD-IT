---
const arcadeBase = import.meta.env.PUBLIC_ARCADE_URL || 'https://play.mayyy.us';
---

<dialog class="command-dialog" data-command-dialog data-arcade-base={arcadeBase}>
  <div class="terminal" role="application" aria-label="MAY'D IT command interface">
    <div class="terminal__header">
      <span>maydit://command</span>
      <span class="terminal__keys">↑↓ history · TAB complete · ESC close</span>
      <button type="button" data-command-close aria-label="Close command interface">ESC</button>
    </div>
    <div class="terminal__history" data-command-history aria-live="polite">
      <p><span class="muted">MAY'D IT command interface v0.2.1</span></p>
      <p>Type <code>help</code> for commands. Try <code>play fragment</code>.</p>
    </div>
    <form class="terminal__form" data-command-form autocomplete="off">
      <label for="command-input">maydit@web:~$</label>
      <input id="command-input" data-command-input name="command" spellcheck="false" autocomplete="off" />
    </form>
  </div>
</dialog>

<script>
  const dialog = document.querySelector('[data-command-dialog]');
  const input = document.querySelector('[data-command-input]');
  const history = document.querySelector('[data-command-history]');
  const form = document.querySelector('[data-command-form]');
  const trigger = document.querySelector('[data-command-trigger]');
  const close = document.querySelector('[data-command-close]');

  if (
    dialog instanceof HTMLDialogElement &&
    input instanceof HTMLInputElement &&
    history instanceof HTMLElement &&
    form instanceof HTMLFormElement
  ) {
    const arcadeBase = dialog.dataset.arcadeBase || 'https://play.mayyy.us';
    const commandHistory = [];
    let historyIndex = 0;

    const print = (content, className = '') => {
      const line = document.createElement('p');
      if (className) line.className = className;
      line.textContent = content;
      history.append(line);
      history.scrollTop = history.scrollHeight;
    };

    const navigate = (url) => {
      window.location.href = url;
    };

    const commands = {
      help: () => [
        'projects        selected engineering work',
        'resume          professional background',
        "about           about MAY'D IT",
        'github          open GitHub',
        'play            open arcade',
        'play snake      launch Snake',
        'play pong       launch Pong',
        'play ttt        launch Tic-Tac-Toe',
        'play signal     launch SIGNAL',
        'play fragment   launch FRAGMENT',
        'whoami          identity summary',
        'status          architecture status',
        'clear           clear terminal',
      ],
      projects: () => navigate('/projects'),
      resume: () => navigate('/resume'),
      about: () => navigate('/about'),
      github: () => navigate('https://github.com/bobbymayyy'),
      play: () => navigate(arcadeBase),
      'play snake': () => navigate(`${arcadeBase}/games/snake`),
      'play pong': () => navigate(`${arcadeBase}/games/pong`),
      'play ttt': () => navigate(`${arcadeBase}/games/tic-tac-toe`),
      'play signal': () => navigate(`${arcadeBase}/games/signal`),
      'play fragment': () => navigate(`${arcadeBase}/games/fragment`),
      whoami: () => [
        'Nathan May',
        'systems · security · infrastructure · automation · software',
      ],
      status: () => [
        'portfolio: static',
        'database: none',
        'public admin: none',
        `arcade: isolated @ ${arcadeBase}`,
        'release: 0.2.1',
      ],
      clear: () => {
        history.replaceChildren();
      },
    };

    const commandNames = Object.keys(commands);

    const openDialog = () => {
      if (!dialog.open) dialog.showModal();
      input.focus();
    };

    const completeCommand = () => {
      const value = input.value.trim().toLowerCase();
      if (!value) return;
      const matches = commandNames.filter((command) => command.startsWith(value));
      if (matches.length === 1) {
        input.value = matches[0];
        input.setSelectionRange(input.value.length, input.value.length);
      } else if (matches.length > 1) {
        print(matches.join('  '), 'muted');
      }
    };

    const moveHistory = (direction) => {
      if (!commandHistory.length) return;
      historyIndex = Math.max(0, Math.min(commandHistory.length, historyIndex + direction));
      input.value = historyIndex === commandHistory.length ? '' : commandHistory[historyIndex];
      input.setSelectionRange(input.value.length, input.value.length);
    };

    trigger?.addEventListener('click', openDialog);
    close?.addEventListener('click', () => dialog.close());

    document.addEventListener('keydown', (event) => {
      if ((event.key === '`' || event.key === '/') && !dialog.open) {
        const target = event.target;
        if (!(target instanceof HTMLInputElement) && !(target instanceof HTMLTextAreaElement)) {
          event.preventDefault();
          openDialog();
        }
      }
    });

    input.addEventListener('keydown', (event) => {
      if (event.key === 'Tab') {
        event.preventDefault();
        completeCommand();
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        moveHistory(-1);
      } else if (event.key === 'ArrowDown') {
        event.preventDefault();
        moveHistory(1);
      }
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const command = input.value.trim().toLowerCase().replace(/\s+/g, ' ');
      if (!command) return;
      print(`maydit@web:~$ ${command}`, 'command-echo');
      commandHistory.push(command);
      historyIndex = commandHistory.length;
      input.value = '';
      const handler = commands[command];
      if (!handler) {
        print(`command not found: ${command}. Try "help" or press TAB.`, 'terminal-error');
        return;
      }
      const output = handler();
      if (Array.isArray(output)) output.forEach((line) => print(line));
    });
  }
</script>
