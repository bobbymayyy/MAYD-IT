---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommandInterface from '../../components/CommandInterface.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
---

<BaseLayout title={`${project.name} · MAY'D IT`} description={project.description}>
  <article class="case-study shell">
    <a class="back-link" href="/projects">← Projects</a>
    <span class="eyebrow">{project.kicker}</span>
    <h1>{project.name}</h1>
    <p class="case-study__lede">{project.description}</p>

    {project.highlights && (
      <div class="case-study__highlights" aria-label="Project highlights">
        {project.highlights.map((highlight) => <span>{highlight}</span>)}
      </div>
    )}

    <div class="case-study__grid">
      <section>
        <h2>Problem</h2>
        <p>{project.problem}</p>
      </section>
      <section>
        <h2>Constraints</h2>
        <ul>
          {project.constraints.map((constraint) => <li>{constraint}</li>)}
        </ul>
      </section>
      <section>
        <h2>Architecture</h2>
        <ol class="architecture-list">
          {project.architecture.map((item, index) => (
            <li><span>{String(index + 1).padStart(2, '0')}</span><p>{item}</p></li>
          ))}
        </ol>
      </section>
      <section>
        <h2>Failures / lessons</h2>
        <ul>
          {project.lessons.map((lesson) => <li>{lesson}</li>)}
        </ul>
      </section>
    </div>

    <div class="case-study__footer">
      <div class="tag-row">
        {project.tags.map((tag) => <span>{tag}</span>)}
      </div>
      {project.repo && <a class="button" href={project.repo} rel="noreferrer">VIEW REPOSITORY →</a>}
    </div>
  </article>
  <CommandInterface slot="after-body" />
</BaseLayout>
