---
import BaseLayout from '../layouts/BaseLayout.astro';
import CommandInterface from '../components/CommandInterface.astro';
import { resume } from '../data/resume';
---

<BaseLayout title="Resume · MAY'D IT" description={resume.summary}>
  <section class="page-intro shell resume-intro">
    <span class="eyebrow">RESUME</span>
    <h1>{resume.name}</h1>
    <p>{resume.headline}</p>
    <p class="page-intro__lede">{resume.summary}</p>
    <div class="hero__actions">
      {resume.publicPdf ? (
        <a class="button button--primary" href={resume.publicPdfPath}>Download PDF</a>
      ) : (
        <span class="button button--disabled" aria-disabled="true">PUBLIC PDF IN PREP</span>
      )}
      <a class="button" href="https://github.com/bobbymayyy">GitHub</a>
    </div>
  </section>

  <section class="section shell split-panel">
    <div>
      <span class="eyebrow">FOCUS</span>
      <ul class="large-list">
        {resume.focus.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <div>
      <span class="eyebrow">PRINCIPLES</span>
      <ol class="principles">
        {resume.principles.map((principle, index) => (
          <li><span>{String(index + 1).padStart(2, '0')}</span>{principle}</li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section shell resume-dropzone">
    <span class="eyebrow">PUBLIC VERSION</span>
    <h2>Built for a sanitized, portable resume.</h2>
    <p>
      The page is already wired for a public PDF. Add <code>apps/site/public/resume.pdf</code> and set
      <code>publicPdf</code> to <code>true</code> in <code>src/data/resume.ts</code> when the public copy is ready.
    </p>
  </section>
  <CommandInterface slot="after-body" />
</BaseLayout>
