# MAY'D IT supply-chain policy.
# Keep installs deterministic and make package execution opt-in by design.
registry=https://registry.npmjs.org/
save-exact=true
save-prefix=
package-lock=true
ignore-scripts=true
audit=false
fund=false
strict-peer-deps=true
engine-strict=true
min-release-age=7
allow-git=none
allow-file=none
allow-directory=all
allow-remote=none
